# Olterra: la interfaz y la API bajo un mismo dominio, con HTTPS automático (Let's Encrypt).
# OLTERRA_DOMINIO y OLTERRA_ACME_EMAIL llegan del .env (ver compose.yml). OLTERRA_API y
# OLTERRA_WEB_RAIZ solo cambian para probar este archivo fuera de Docker.
{
	email {$OLTERRA_ACME_EMAIL}
}

{$OLTERRA_DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# La API. /docs es la documentación interactiva (Swagger), que carga sus propios scripts:
	# por eso la CSP estricta va solo en la interfaz.
	@api path /v1/* /health /docs /docs/* /openapi.json
	handle @api {
		request_body {
			max_size 30MB
		}
		reverse_proxy {$OLTERRA_API:api:8000}
	}

	# La interfaz: archivos del build y, para cualquier otra ruta, index.html (la SPA).
	handle {
		root * {$OLTERRA_WEB_RAIZ:/srv}
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		# Los archivos de /assets llevan hash en el nombre: se guardan un año. El resto no,
		# para que un despliegue nuevo se vea de inmediato.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
