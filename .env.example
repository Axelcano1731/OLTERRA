# Copiar a .env (que NO se versiona) y completar.
OLTERRA_ENV=dev

# Base de datos: la API entra como olterra_app (sin bypass de RLS);
# migraciones y olterra-admin, como olterra_owner.
OLTERRA_DATABASE_URL=postgresql+asyncpg://olterra_app:olterra_app@localhost:5432/olterra
OLTERRA_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://olterra_owner:olterra_owner@localhost:5432/olterra

OLTERRA_NATS_URL=nats://localhost:4222

# Bóveda: olterra-admin generar-llave-maestra
OLTERRA_MASTER_KEY=

# Ejecutor: olterra-admin generar-llaves-ejecutor
# La privada va SOLO donde corre el ejecutor; la pública, en la API.
OLTERRA_EXECUTOR_PRIVATE_KEY=
OLTERRA_EXECUTOR_PUBLIC_KEY=
OLTERRA_EXECUTOR_GROUP=cloud

# Concentrador WireGuard (CHR). La pública sale de /interface wireguard print en el CHR.
OLTERRA_TUNNEL_HUB_HOST=
OLTERRA_TUNNEL_HUB_PORT=13231
OLTERRA_TUNNEL_HUB_PUBLIC_KEY=
